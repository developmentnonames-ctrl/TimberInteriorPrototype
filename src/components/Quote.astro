---
const W = 526, H = 749;
const rows = 18, pen = (H / rows) * 1.3;
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
let d = `M ${-40} ${pen * 0.3}`;
for (let r = 0; r < rows; r++) {
  const y = ((r + 0.5) / rows) * H;
  const ltr = r % 2 === 0;
  const x0 = ltr ? -40 : W + 40, x1 = ltr ? W + 40 : -40;
  const c1y = y + (rnd() - 0.5) * pen * 0.35, c2y = y + (rnd() - 0.5) * pen * 0.35;
  d += ` L ${x0} ${y.toFixed(1)} C ${(x0 + (x1 - x0) * 0.35).toFixed(1)} ${c1y.toFixed(1)}, ${(x0 + (x1 - x0) * 0.65).toFixed(1)} ${c2y.toFixed(1)}, ${x1} ${(y + pen * 0.15).toFixed(1)}`;
}
---
<section class="quote" aria-label="A note from Kaia" data-quote>
  <figure class="quote__img">
    <svg class="quote__draw" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Pencil sketch of a tall wooden vase on a table">
      <defs>
        <mask id="quote-pen" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
          <path class="quote__scribble" data-quote-pen d={d} fill="none" stroke="#fff" stroke-width={pen} stroke-linecap="round" stroke-linejoin="round" />
        </mask>
      </defs>
      <image href="/images/vase-sketch-lines.webp" width={W} height={H} mask="url(#quote-pen)" />
    </svg>
  </figure>
  <blockquote class="quote__text">
    <p class="serif-xl" data-quote-text>“In a world that rewards speed, we choose time and touch.”</p>
    <footer class="quote__by" data-quote-by>
      <img class="quote__avatar" src="/images/kaia-avatar.jpg" alt="" width="56" height="56" loading="lazy" />
      <span class="quote__who">
        <cite class="hand quote__name">Kaia</cite>
        <span class="quote__role">Timbre Studio</span>
      </span>
    </footer>
  </blockquote>
</section>

<style>
  .quote {
    position: relative;
    z-index: 2;
    background: #fff;
    padding: clamp(110px, 18vh, 220px) var(--gutter);
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: clamp(24px, 5vw, 96px);
    align-items: center;
  }
  .quote__img { margin: 0; display: grid; place-items: center; }
  .quote__draw { display: block; width: 100%; height: auto; max-height: 76svh; }
  .quote__text { margin: 0; }
  .quote__by { display: flex; align-items: center; gap: 16px; margin-top: clamp(28px, 4.5svh, 44px); }
  .quote__avatar {
    width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex: none;
    box-shadow: 0 0 0 3px #fff, 0 0 0 4px rgba(138, 92, 50, 0.35);
  }
  .quote__who { display: grid; gap: 2px; }
  .quote__name { font-style: normal; font-size: 34px; line-height: 0.9; color: var(--rattan); }
  .quote__role { font-size: 14px; letter-spacing: 0.02em; color: var(--ink-soft); }
  @media (max-width: 820px) {
    .quote { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 36px; padding: 96px var(--gutter) 104px; }
    .quote__img { width: min(64%, 320px); }
    .quote__text { max-width: 560px; }
    .quote__text p { margin: 0; font-size: clamp(30px, 8.2vw, 48px); line-height: 1.12; text-wrap: balance; }
    .quote__by { justify-content: center; margin-top: 30px; text-align: left; }
  }
  @media (min-width: 821px) {
    .quote { min-height: 100svh; padding-block: max(8svh, 100px) 6svh; }
  }
</style>
