---
import srcsetData from '../data/srcset.json';
const srcset: Record<string, string> = srcsetData;
const uses = [
  { n: '01', t: 'Boutique hotels', d: 'Lobby lounges and suites that feel like a home someone cared about.', img: '/images/spaces-hotel.jpg', alt: 'A hotel lobby lounge with the Marcel sofa, armchairs and guests reading by tall windows' },
  { n: '02', t: 'Cafés & bars', d: 'Bar chairs at the right height, built for a thousand coffees a week.', img: '/images/spaces-cafe.jpg', alt: 'Nico bar chairs lined up at a sunlit café counter' },
  { n: '03', t: 'Retreats & villas', d: 'Outdoor rattan made for salt air, monsoon and slow afternoons.', img: '/images/spaces-retreat.jpg', alt: 'The Sling lounger on a villa terrace beside a pool and palms' },
];
---
<section class="spaces" id="spaces" data-tone="dark" data-spaces aria-labelledby="spaces-title">
  <div class="spaces__head">
    <h2 class="serif-xl" id="spaces-title" data-split>Made for the places <em>people return to.</em></h2>
    <p class="spaces__sub">Handcrafted pieces for boutique hotels, cafés and retreats, with custom heights, finishes and trade pricing.</p>
  </div>

  <ol class="spaces__uses">
    {uses.map((u) => (
      <li class="use">
        <div class="use__img" data-reveal-img><img src={u.img} srcset={srcset[u.img]} sizes="auto, 30vw" alt={u.alt} loading="lazy" /></div>
        <h3 class="use__title"><span class="display display--condensed">{u.n}</span>{u.t}</h3>
        <p>{u.d}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .spaces {
    position: relative; z-index: 2;
    background: var(--terracotta); color: var(--line);
    padding: clamp(96px, 14vh, 180px) var(--gutter) clamp(72px, 10vh, 120px);
    overflow: hidden;
  }
  .spaces__head { display: grid; grid-template-columns: 1fr auto; gap: 24px 48px; align-items: end; }
  .spaces__head h2 { max-width: 14ch; }
  .spaces__head em { color: #f6d7b4; }
  .spaces__sub { margin: 0; opacity: 0.88; max-width: 34ch; line-height: 1.55; text-wrap: pretty; }

  .spaces__uses { list-style: none; padding: 0; margin: clamp(40px, 7vh, 80px) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 40px); }
  .use { min-width: 0; }
  .use__img { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: rgba(0, 0, 0, 0.08); }
  .use__img img { width: 100%; height: 100%; object-fit: cover; }
  .use__img::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(42, 24, 14, 0.12) 0%, rgba(42, 24, 14, 0.2) 55%, rgba(42, 24, 14, 0.32) 100%);
  }
  .use__title {
    display: flex; align-items: baseline; gap: 12px; margin: 18px 0 8px;
    font-family: var(--f-display); font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .use__title .display { font-size: 30px; letter-spacing: 0; color: #f6d7b4; }
  .use p { margin: 0; font-size: 15px; line-height: 1.55; opacity: 0.88; max-width: 34ch; text-wrap: pretty; }

  @media (max-width: 820px) {
    .spaces__head { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .spaces__uses { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (min-width: 601px) and (max-width: 820px) {
    .use__title { flex-wrap: wrap; gap: 4px 10px; font-size: 12px; }
    .use p { font-size: 14px; }
  }
  @media (min-width: 821px) and (min-height: 501px) {
    .spaces {
      --top: max(10svh, 100px);
      --h: min(calc(100svh - var(--top) - 5svh - 7.5svh - 4svh - 118px), calc((100vw - 2 * var(--gutter) - 2 * 32px) / 3 * 1.25));
      height: 100svh; padding: var(--top) var(--gutter) 5svh;
      display: flex; flex-direction: column; justify-content: center;
    }
    .spaces__head { align-items: end; }
    .spaces__head h2 { max-width: none; font-size: clamp(36px, min(3.7vw, 7.5svh), 76px); }
    .spaces__sub { max-width: 46ch; margin-bottom: 0.4em; }
    .spaces__uses {
      margin-top: 4svh;
      grid-template-columns: repeat(3, calc(var(--h) * 0.8));
      justify-content: space-between; column-gap: 32px;
    }
    .use__img { height: var(--h); }
    .use__title { margin: 2svh 0 0.8svh; }
    .use p { font-size: clamp(14px, 1.8svh, 15px); }
  }
</style>
