---
import '../styles/fonts.css';
import '../styles/global.css';

const title = 'Timbre Interior';
const description = 'Handcrafted teak and rattan furniture, designed around the people who use it. Made to order in Sri Lanka.';
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ede4d3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/caveat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      var cl = document.documentElement.classList;
      cl.remove('no-js');
      var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (calm) cl.add('reduced');
      if (!calm && !/[?&]noloader/.test(location.search)) {
        cl.add('booting');
        setTimeout(function () { if (cl.contains('booting') && !cl.contains('loader-armed')) cl.add('show-loader'); }, 400);
        addEventListener('load', function () { setTimeout(function () { if (!cl.contains('js-on')) cl.remove('booting', 'show-loader'); }, 1500); });
      }
</script>
  </head>
  <body>
    <slot />
    <div class="grain" aria-hidden="true"></div>
    <script>
      import '../scripts/main.js';
</script>
  </body>
</html>
