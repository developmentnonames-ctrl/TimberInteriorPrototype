{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".astro/**",
    "assets-src/**",
    "images/**",
    "public/**"
  ],
  "env": {
    "browser": true,
    "worker": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "unicorn/require-post-message-target-origin": "off"
  },
  "overrides": [
    {
      "files": [
        "tools/wood-texture.cjs"
      ],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
